{
  "folders": [
    {
      "name": "Django Backend",
      "path": "./packages/backend-django"
    },
    {
      "name": "TypeScript Backend",
      "path": "./packages/backend"
    },
    {
      "name": "Frontend",
      "path": "./packages/frontend"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "./packages/backend-django/venv/Scripts/python.exe",
    "python.analysis.extraPaths": ["./packages/backend-django"],
    "python.terminal.activateEnvironment": true,
    "typescript.preferences.includePackageJsonAutoImports": "auto",
    "eslint.workingDirectories": [
      "packages/frontend",
      "packages/backend"
    ],
    "files.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/venv": true,
      "**/.git": true,
      "**/dist": true,
      "**/build": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.git": true,
      "**/venv": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.pylint",
      "ms-python.black-formatter",
      "ms-vscode.vscode-typescript-next",
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "ms-vscode.vscode-json",
      "redhat.vscode-yaml",
      "ms-vscode-remote.remote-containers"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install All Dependencies",
        "type": "shell",
        "command": "npm",
        "args": ["install"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Setup Python Virtual Environment",
        "type": "shell",
        "command": "python",
        "args": ["-m", "venv", "venv"],
        "options": {
          "cwd": "${workspaceFolder}/eldspotter/backend"
        },
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "Install Python Dependencies",
        "type": "shell",
        "command": "venv/Scripts/pip",
        "args": ["install", "-r", "requirements.txt"],
        "options": {
          "cwd": "${workspaceFolder}/eldspotter/backend"
        },
        "group": "build",
        "dependsOn": "Setup Python Virtual Environment"
      },
      {
        "label": "Start Django Development Server",
        "type": "shell",
        "command": "venv/Scripts/python",
        "args": ["manage.py", "runserver"],
        "options": {
          "cwd": "${workspaceFolder}/eldspotter/backend"
        },
        "group": "test",
        "isBackground": true,
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated"
        },
        "problemMatcher": {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^Performing system checks",
            "endsPattern": "^.*Development server is running at.*$"
          }
        }
      },
      {
        "label": "Start TypeScript Backend",
        "type": "shell",
        "command": "npm",
        "args": ["run", "dev"],
        "options": {
          "cwd": "${workspaceFolder}/packages/backend"
        },
        "group": "test",
        "isBackground": true
      },
      {
        "label": "Start Frontend Development Server",
        "type": "shell",
        "command": "npm",
        "args": ["run", "dev"],
        "options": {
          "cwd": "${workspaceFolder}/packages/frontend"
        },
        "group": "test",
        "isBackground": true
      },
      {
        "label": "Build All",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build"],
        "group": "build",
        "dependsOrder": "sequence"
      }
    ]
  }
}