{
  "name": "spotter-eld-system",
  "version": "1.0.0",
  "private": true,
  "description": "Electronic Logging Device (ELD) system for managing driver hours of service",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace packages/frontend run dev",
    "dev:backend": "npm --workspace packages/local-dev-backend run dev",
    "dev:django": "npm --workspace packages/django-backend run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "npm --workspace packages/frontend run build",
    "build:backend": "npm --workspace packages/local-dev-backend run build",
    "preview": "npm --workspace packages/frontend run preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d packages/frontend/dist",
    "lint": "npm --workspace packages/frontend run lint",
    "lint:fix": "npm --workspace packages/frontend run lint -- --fix"
  },
  "homepage": "https://markmwendwa722.github.io/ELD-System",
  "keywords": [
    "eld",
    "electronic-logging-device",
    "fleet-management",
    "hours-of-service"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0"
  },
  "dependencies": {
    "react-hot-toast": "^2.6.0"
  }
}
