{
  "name": "@spotter/frontend",
  "version": "1.0.0",
  "description": "Spotter React Frontend Application",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tailwindcss -i ./src/App.css -o ./src/output.css --watch\" \"vite\"",
    "build": "tailwindcss -i ./src/App.css -o ./src/output.css && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^4.32.0",
    "@types/lodash": "^4.17.20",
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "maplibre-gl": "^5.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "tailwindcss-animation": "^1.0.1",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
