{
  "name": "spotter-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "start:backend": "npm --workspace packages/backend run dev",
    "start:client": "npm --workspace packages/Client run dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:client\"",
    "build": "npm --workspaces run build",
    "lint": "eslint . --ext .ts,.tsx,.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
